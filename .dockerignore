# Everything the image does not need. Keeps the build small and stops a local
# .env from being baked into a published image.
.git
.venv
.env
web/node_modules
web/.next
design
docs
eval/runs
# Only the 5000-scale set is excluded — it is 20x the size and nothing the
# hosted demo serves. The eight small seeds ship, so ?seed=N works live for
# every seed the README quotes.
data/seed42-5000
**/__pycache__
*.pyc
