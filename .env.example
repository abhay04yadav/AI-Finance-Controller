# Copy to .env. Never commit .env. Guide §9.8.
#
# The API key is read from the environment only, never from a config file and
# never committed. Gates 0-10 need none of this: `--no-llm` is a first-class
# supported mode, not a debug flag (§4.4).

# Gate 11 only. Leave blank until L4 is built.
ANTHROPIC_API_KEY=

# Gate 8 only.
DATABASE_URL=postgresql://localhost:5432/afc

# All business dates are Asia/Kolkata. Never UTC, never naive (§2.7 rule 6).
TZ=Asia/Kolkata
